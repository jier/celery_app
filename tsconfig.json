{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": false,
    "outDir": "static/dist",
    "rootDir": "static",
    "sourceMap": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["static/**/*.ts"]
}
